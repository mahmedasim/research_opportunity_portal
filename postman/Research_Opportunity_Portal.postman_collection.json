        "description": "Demonstrates Section 6, Item 1: Health check endpoint returning server status."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Status response is ok\", function () {",
              "    var jsonData = pm.response.json();",
